# Supply-chain hardening.
#
# Never execute package lifecycle scripts on install. This is the main way a
# compromised dependency runs code on your machine, and it fires before you
# have run anything yourself. None of this project's dependencies need one:
# sharp ships prebuilt binaries as optional dependencies, and puppeteer-core
# deliberately downloads no browser (it drives the system Chromium instead).
ignore-scripts=true

# Record exact versions rather than a caret range, so `npm install <pkg>`
# cannot silently widen what is allowed.
save-exact=true

# Install strictly from package-lock.json. Prefer `npm ci` over `npm install`.
prefer-offline=false
fund=false
audit=true
